<mxfile host="app.diagrams.net" type="device">
  <diagram id="level-two" name="Level 2 - Terminal Menu">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="LEVEL 2 — FUNCTIONAL TERMINAL MENU" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#183153;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="New application and CLI classes are planned by specs/001-terminal-menu. Gray boxes are existing Level 1 components reused unchanged." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#52657a;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1400" height="30" as="geometry" /></mxCell>

        <mxCell id="terminal" value="TerminalMenu «CLI adapter»&#10;—&#10;+ run(): int&#10;+ parse user input&#10;+ render output and errors" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=14;fillColor=#e8f3ff;strokeColor=#3973a5;" vertex="1" parent="1"><mxGeometry x="710" y="120" width="380" height="130" as="geometry" /></mxCell>
        <mxCell id="session" value="SalesSession «application»&#10;—&#10;- workspaces: tuple[CompanyWorkspace, ...]&#10;- current: CompanyWorkspace | None&#10;- selection: Selection&#10;—&#10;+ create_company(...)&#10;+ select_company(...)&#10;+ selected_sales()&#10;+ run_*_analysis() / run_forecast()" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#e8f3ff;strokeColor=#3973a5;" vertex="1" parent="1"><mxGeometry x="100" y="310" width="430" height="210" as="geometry" /></mxCell>
        <mxCell id="workspace" value="CompanyWorkspace «application»&#10;—&#10;- company: Company&#10;- products: tuple[Product, ...]&#10;- sales: SalesDataset&#10;—&#10;+ register_product(...)&#10;+ record_sale(...)&#10;+ import_sales(...)" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#e8f3ff;strokeColor=#3973a5;" vertex="1" parent="1"><mxGeometry x="650" y="310" width="390" height="190" as="geometry" /></mxCell>
        <mxCell id="selection" value="Selection «value object»&#10;—&#10;+ start: date | None&#10;+ end: date | None&#10;—&#10;Represents all data or an inclusive date range" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#eef8ed;strokeColor=#5c8b53;" vertex="1" parent="1"><mxGeometry x="120" y="590" width="330" height="130" as="geometry" /></mxCell>
        <mxCell id="records" value="ItemInput «value object»&#10;product_id, quantity, unit_price, unit_cost&#10;&#10;ImportSummary «value object»&#10;sales_added, items_added, new_products, reused_products" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#eef8ed;strokeColor=#5c8b53;" vertex="1" parent="1"><mxGeometry x="650" y="570" width="390" height="150" as="geometry" /></mxCell>
        <mxCell id="errors" value="ApplicationError «error hierarchy»&#10;├ NoCompanySelectedError&#10;├ DuplicateCompanyError / DuplicateProductError&#10;├ CompanyNotFoundError / UnknownProductError&#10;├ DuplicateSaleError / CatalogConflictError&#10;├ InvalidPeriodError / NoSalesInSelectionError&#10;└ InsufficientHistoryError&#10;&#10;Messages are safe; structured details stay in attributes." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#fff1ed;strokeColor=#ba6655;" vertex="1" parent="1"><mxGeometry x="1190" y="310" width="500" height="250" as="geometry" /></mxCell>

        <mxCell id="data-importer" value="«abstract» DataImporter&#10;+ load(path, company): SalesDataset" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#f1f2f3;strokeColor=#828b94;" vertex="1" parent="1"><mxGeometry x="1190" y="620" width="500" height="70" as="geometry" /></mxCell>
        <mxCell id="csv-importer" value="CSVImporter&#10;+ load(path, company): SalesDataset" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#f1f2f3;strokeColor=#828b94;" vertex="1" parent="1"><mxGeometry x="1190" y="730" width="500" height="70" as="geometry" /></mxCell>
        <mxCell id="analysis" value="«abstract» Analysis&#10;+ run(data: SalesDataset): AnalysisResult" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#f1f2f3;strokeColor=#828b94;" vertex="1" parent="1"><mxGeometry x="650" y="800" width="390" height="70" as="geometry" /></mxCell>
        <mxCell id="financial-analysis" value="FinancialAnalysis&#10;+ run(data): AnalysisResult" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f1f2f3;strokeColor=#828b94;" vertex="1" parent="1"><mxGeometry x="560" y="900" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="product-analysis" value="ProductAnalysis&#10;+ run(data): AnalysisResult" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#f1f2f3;strokeColor=#828b94;" vertex="1" parent="1"><mxGeometry x="870" y="900" width="260" height="70" as="geometry" /></mxCell>
        <mxCell id="forecaster" value="RevenueForecaster «existing»&#10;+ forecast(data): ForecastResult" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#f1f2f3;strokeColor=#828b94;" vertex="1" parent="1"><mxGeometry x="1190" y="850" width="500" height="90" as="geometry" /></mxCell>

        <mxCell id="domain" value="EXISTING DOMAIN — unchanged and reused by the application layer&#10;&#10;Company ── Product (association)&#10;Company ── Sale ◆── SaleItem ── Product&#10;SalesDataset ── Sale (association)&#10;&#10;Sale owns its SaleItems (composition). Filtered datasets may share Sale objects." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#f1f2f3;strokeColor=#828b94;" vertex="1" parent="1"><mxGeometry x="100" y="800" width="430" height="180" as="geometry" /></mxCell>

        <mxCell id="e1" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#3973a5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="terminal" target="session"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="contains 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;startArrow=diamond;startFill=1;endArrow=none;strokeColor=#3973a5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="session" target="workspace"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="holds current selection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=none;strokeColor=#3973a5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="session" target="selection"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="uses for manual sale" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#3973a5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="workspace" target="records"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="imports via" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#3973a5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="workspace" target="csv-importer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="raises" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#ba6655;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="workspace" target="errors"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#3973a5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="session" target="analysis"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#3973a5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="session" target="forecaster"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="uses existing domain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#828b94;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="workspace" target="domain"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="inherits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=0;strokeColor=#828b94;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="csv-importer" target="data-importer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="inherits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=0;strokeColor=#828b94;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="financial-analysis" target="analysis"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="inherits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=0;strokeColor=#828b94;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="product-analysis" target="analysis"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="legend" value="Solid line = association   ·   Filled diamond = composition   ·   Dashed arrow = dependency/use   ·   Hollow triangle = inheritance" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#52657a;" vertex="1" parent="1"><mxGeometry x="40" y="1030" width="1500" height="30" as="geometry" /></mxCell>
