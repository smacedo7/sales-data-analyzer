<mxfile host="app.diagrams.net"><diagram name="Level 3"><mxGraphModel page="1" pageWidth="1440" pageHeight="1180"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Level 3 — Persistence, exploration, forecast comparison and charts (implemented)" style="text;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="1200" height="30" /></mxCell><mxCell id="legend" value="Green: cli/. Blue: application/. Purple: persistence/, exploration/, charts/ (new). Amber: forecasting methods and comparison (new). Gray: level 1, unchanged." style="text;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="56" width="1300" height="24" /></mxCell><mxCell id="menu" value="TerminalMenu&#10;options 1-12 (level 2) and 13-22 (level 3)&#10;13-17 edit company/product, delete product/sale, list sales&#10;18-19 sales over time, compare periods&#10;20 compare forecast methods&#10;21-22 text charts, save chart images&#10;persistent mode: exit needs no confirmation" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#ecfdf5;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="110" width="420" height="169" /></mxCell><mxCell id="fmt" value="formatting «module»&#10;format_sales(); format_table()&#10;format_temporal(); format_weekdays(); format_categories()&#10;format_period_comparison()&#10;format_comparison(); format_comparison_estimates()" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#ecfdf5;" vertex="1" parent="1"><mxGeometry as="geometry" x="520" y="110" width="420" height="129" /></mxCell><mxCell id="run" value="run(argv) «entry point»&#10;--database PATH (default: per-user data folder)&#10;opens SQLiteSalesRepository; SalesSession.open()&#10;exit status 2 when the file cannot be used" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#ecfdf5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1000" y="110" width="400" height="109" /></mxCell><mxCell id="session" value="SalesSession&#10;open(repository) «classmethod»&#10;update_company(name?, sector?)&#10;sales_over_time(); weekday_profile(); category_totals()&#10;compare_periods(first, second: Selection)&#10;compare_forecasts(horizon, missing_days, utc_offset, method)" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#eff6ff;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="360" width="420" height="149" /></mxCell><mxCell id="workspace" value="CompanyWorkspace&#10;from_stored(stored, repository) «classmethod»&#10;update_product(); delete_product(); sales_with_product()&#10;find_sale(); list_sales(); delete_sale()&#10;validate -&gt; write to repository -&gt; swap memory" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#eff6ff;" vertex="1" parent="1"><mxGeometry as="geometry" x="520" y="360" width="420" height="129" /></mxCell><mxCell id="repo" value="SalesRepository «abstract»&#10;load(): tuple[StoredCompany, ...]&#10;add_company(); update_company()&#10;add_product(); update_product(); delete_product()&#10;add_sales(); delete_sale(); close()&#10;location: str | None" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#eff6ff;" vertex="1" parent="1"><mxGeometry as="geometry" x="1000" y="360" width="400" height="149" /></mxCell><mxCell id="errors" value="errors «module»&#10;PersistenceError; ConcurrentChangeError; StorageLimitError&#10;ProductNotFoundError; ProductInUseError(sale_count)&#10;SaleNotFoundError" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#eff6ff;" vertex="1" parent="1"><mxGeometry as="geometry" x="1000" y="880" width="400" height="109" /></mxCell><mxCell id="sqlite" value="SQLiteSalesRepository&#10;open(path) «classmethod»; BEGIN IMMEDIATE writes&#10;STRICT tables company, product, sale, sale_item&#10;amounts as plain decimal TEXT; FK RESTRICT/CASCADE&#10;DatabaseOpenError; CorruptDataError(table, count)" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#f5f3ff;" vertex="1" parent="1"><mxGeometry as="geometry" x="1000" y="620" width="400" height="129" /></mxCell><mxCell id="explore" value="exploration «module» (pandas, lazy import)&#10;temporal_summary(); weekday_profile()&#10;category_totals(); compare_periods()&#10;PeriodTotal; TemporalSummary; WeekdayProfile&#10;CategoryTotal; PeriodComparison (Decimal fields)" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#f5f3ff;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="620" width="420" height="129" /></mxCell><mxCell id="charts" value="charts «package»&#10;bar_lines(rows, width=40) (no dependency)&#10;images.save_charts(inputs, folder, replace) (Matplotlib Agg)&#10;ChartInputs; ChartWriteError&#10;temporary file + rename; replace only after confirmation" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#f5f3ff;" vertex="1" parent="1"><mxGeometry as="geometry" x="520" y="620" width="420" height="129" /></mxCell><mxCell id="compare" value="compare_methods(history, horizon, methods, method)&#10;rolling origin: K blocks of 7 days, K &lt;= 4, n &gt;= 12&#10;MethodScore; SkippedMethod; ComparisonResult&#10;lowest error named only with &gt;= 14 evaluated days&#10;negative estimates floored at 0 and reported" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fffbeb;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="880" width="420" height="129" /></mxCell><mxCell id="method" value="ForecastMethod «abstract»&#10;key; title; kind; min_training_days&#10;predict(training, days): tuple[float, ...]&#10;fit_summary(training): FitSummary | None" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;vert