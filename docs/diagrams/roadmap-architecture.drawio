<mxfile host="app.diagrams.net" type="device">
  <diagram id="level-three" name="Level 3 - Persistence and analytics">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root>
      <mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="title" value="LEVEL 3 — PERSISTENCE AND DATA ANALYSIS (PROPOSED)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#183153;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1100" height="40" as="geometry" /></mxCell>
      <mxCell id="note" value="The assignment requires a working database at this level. Analytics additions below are portfolio milestones to schedule alongside the Data Science and Visualization lessons." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#52657a;" vertex="1" parent="1"><mxGeometry x="35" y="60" width="1450" height="35" as="geometry" /></mxCell>
      <mxCell id="session" value="SalesSession / CompanyWorkspace&#10;existing application services&#10;—&#10;Coordinate use cases and business rules" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#f1f2f3;strokeColor=#828b94;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="300" height="120" as="geometry" /></mxCell>
      <mxCell id="ports" value="Repository ports «planned»&#10;CompanyRepository&#10;SalesRepository&#10;—&#10;Persistence contracts owned by application" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="440" y="180" width="330" height="135" as="geometry" /></mxCell>
      <mxCell id="sqlite" value="SQLite adapters «planned»&#10;SQLiteCompanyRepository&#10;SQLiteSalesRepository&#10;SQLAlchemy mappings / unit of work" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="880" y="180" width="380" height="135" as="geometry" /></mxCell>
      <mxCell id="tabular" value="TabularSalesAdapter «planned»&#10;+ to_frame(data: SalesDataset): DataFrame&#10;Pandas stays at the analysis boundary" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="350" height="115" as="geometry" /></mxCell>
      <mxCell id="temporal" value="TemporalAnalysis «planned»&#10;inherits Analysis&#10;+ run(data): AnalysisResult&#10;Daily / weekly / monthly trends and period comparisons" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="360" height="150" as="geometry" /></mxCell>
      <mxCell id="charts" value="ChartGenerator «planned»&#10;+ generate(chart_data, kind): Figure&#10;Matplotlib: comparison, distribution, composition, relationship" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="970" y="420" width="380" height="140" as="geometry" /></mxCell>
      <mxCell id="report" value="ReportBuilder + PdfExporter «planned»&#10;Combine selected KPIs, period comparisons and chart files into a PDF report." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="970" y="680" width="380" height="110" as="geometry" /></mxCell>
      <mxCell id="schedule" value="WHEN: Level 3 begins with SQLite persistence (assignment requirement). After course units 7–8, add charts; after units 9–11, add exploration and hypothesis tests. PDF reporting follows once KPI and chart outputs are stable. These are portfolio milestones, not additional SIGAA level requirements." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#f7f9fc;strokeColor=#91a3b8;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="1290" height="105" as="geometry" /></mxCell>
      <mxCell id="e1" value="uses abstractions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="session" target="ports"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="e2" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=0;strokeColor=#b68b43;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sqlite" target="ports"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="e3" value="converts domain data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tabular" target="temporal"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="e4" value="produces typed results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="temporal" target="charts"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="e5" value="report inputs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="charts" target="report"><mxGeometry relative="1" as="geometry" /></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="level-four" name="Level 4 - Desktop interface">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root>
      <mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="title" value="LEVEL 4 — DESKTOP INTERFACE (PROPOSED)" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#183153;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1000" height="40" as="geometry" /></mxCell>
      <mxCell id="note" value="Level 4 assignment requirement: a graphical interface with windows, buttons and custom styling. PySide6 / Qt Widgets is the planned adapter." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#52657a;" vertex="1" parent="1"><mxGeometry x="35" y="60" width="1400" height="35" as="geometry" /></mxCell>
      <mxCell id="window" value="MainWindow «PySide6»&#10;Application shell / navigation&#10;—&#10;CompanySelector&#10;DashboardView&#10;SalesView / ImportDialog" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=14;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="360" height="190" as="geometry" /></mxCell>
      <mxCell id="controller" value="DesktopController «planned»&#10;Translate UI actions into application calls; return typed results and user-safe errors." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="570" y="210" width="390" height="140" as="geometry" /></mxCell>
      <mxCell id="app" value="Application layer&#10;SalesSession · CompanyWorkspace&#10;Repository ports&#10;Level 2 use cases reused by GUI" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#e8f3ff;strokeColor=#3973a5;" vertex="1" parent="1"><mxGeometry x="1090" y="210" width="340" height="140" as="geometry" /></mxCell>
      <mxCell id="charts" value="Dashboard widgets «planned»&#10;KpiPanel · SalesTable · ChartPanel&#10;Qt displays chart figures from ChartGenerator; presentation does not calculate business metrics." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="440" height="155" as="geometry" /></mxCell>
      <mxCell id="report" value="Report interaction «planned»&#10;Choose period and metrics → preview/export PDF via application reporting service." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="650" y="520" width="390" height="130" as="geometry" /></mxCell>
      <mxCell id="infra" value="Infrastructure reused&#10;SQLite repositories · CSV importer&#10;Analysis services · ChartGenerator&#10;PdfExporter" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#f1f2f3;strokeColor=#828b94;" vertex="1" parent="1"><mxGeometry x="1090" y="510" width="340" height="140" as="geometry" /></mxCell>
      <mxCell id="timing" value="WHEN: after the terminal workflow and Level 3 persistence/analytics are stable. The graphical UI reuses the same application operations; it is not a rewrite of the domain or CSV rules." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=13;fillColor=#f7f9fc;strokeColor=#91a3b8;" vertex="1" parent="1"><mxGeometry x="80" y="750" width="1350" height="80" as="geometry" /></mxCell>
      <mxCell id="e1" value="user events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="window" target="controller"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="e2" value="calls use cases" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="controller" target="app"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="e3" value="renders outputs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="controller" target="charts"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="e4" value="uses services" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="app" target="infra"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="e5" value="requests export" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="report" target="infra"><mxGeometry relative="1" as="geometry" /></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="data-science" name="Portfolio - Data Science and ML">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root>
      <mxCell id="0" /><mxCell id="1" parent="0" />
      <mxCell id="title" value="PORTFOLIO EXTENSIONS — DATA SCIENCE AND MACHINE LEARNING" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=23;fontStyle=1;fontColor=#183153;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1300" height="40" as="geometry" /></mxCell>
      <mxCell id="note" value="Basic ML already exists: RevenueForecaster uses linear regression, chronological evaluation, MAE/RMSE and a naive baseline. The classes below are future design candidates, not committed requirements." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#52657a;" vertex="1" parent="1"><mxGeometry x="35" y="60" width="1480" height="40" as="geometry" /></mxCell>
      <mxCell id="sales" value="SalesDataset&#10;validated domain records" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#f1f2f3;strokeColor=#828b94;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="300" height="95" as="geometry" /></mxCell>
      <mxCell id="prep" value="ExploratoryAnalysis + HypothesisTest «planned»&#10;Summaries, distributions and explicitly stated statistical hypotheses." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="470" y="180" width="390" height="130" as="geometry" /></mxCell>
      <mxCell id="features" value="FeatureBuilder «planned»&#10;Build leakage-aware tabular features from sales data; keep ML arrays/tables outside domain entities." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="470" y="420" width="390" height="130" as="geometry" /></mxCell>
      <mxCell id="workflow" value="ModelingWorkflow «planned»&#10;Define target/task · chronological or stratified split · train · evaluate · compare with baseline" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="1010" y="190" width="420" height="130" as="geometry" /></mxCell>
      <mxCell id="models" value="Model families «planned after relevant courses»&#10;Regression: linear models, regression trees&#10;Classification: binary / multiclass classifiers&#10;Unsupervised: clustering / segmentation&#10;Time series: evaluate against naive baselines" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="1010" y="430" width="420" height="170" as="geometry" /></mxCell>
      <mxCell id="metrics" value="ModelEvaluator «planned»&#10;Regression: MAE / RMSE (and task-appropriate metrics)&#10;Classification: confusion matrix, precision, recall, F1&#10;Always document split, baseline and limitations" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=13;fillColor=#fff4df;strokeColor=#b68b43;" vertex="1" parent="1"><mxGeometry x="1010" y="690" width="420" height="145" as="geometry" /></mxCell>
      <mxCell id="optional" value="OPTIONAL / SEPARATE LEARNING LABS — not core desktop dependencies&#10;NLP needs relevant text data; Spark/AWS Glue need scale or a concrete pipeline use case. Revisit after the core app and course modules; do not add solely to enlarge the stack." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontSize=13;fillColor=#f7f9fc;strokeColor=#91a3b8;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="800" height="135" as="geometry" /></mxCell>
      <mxCell id="timing" value="WHEN: apply EDA and hypothesis testing after the respective Data Science units; add classifier/regression-tree/clustering experiments after units 14–22. This is the final expansion after core menu, persistence, visualization and desktop flows. NLP/Spark/AWS remain optional unless a justified sales-data problem appears." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=12;fontSize=13;fillColor=#f7f9fc;strokeColor=#91a3b8;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="1370" height="80" as="geometry" /></mxCell>
      <mxCell id="e1" value="explores" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sales" target="prep"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="e2" value="derives features" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sales" target="features"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="e3" value="feature matrix" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="features" target="workflow"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="e4" value="trains and compares" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="workflow" target="models"><mxGeometry relative="1" as="geometry" /></mxCell>
      <mxCell id="e5" value="evaluates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=open;dashed=1;strokeColor=#52657a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="models" target="metrics"><mxGeometry relative="1" as="geometry" /></mxCell>
    </root></mxGraphModel>
  </diagram>
</mxfile>
