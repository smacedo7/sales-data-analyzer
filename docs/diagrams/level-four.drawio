<mxfile host="app.diagrams.net"><diagram name="Level 4"><mxGraphModel page="1" pageWidth="1440" pageHeight="880"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Level 4 — Desktop interface, explorable charts and PDF report (implemented)" style="text;fontSize=20;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="1300" height="30" /></mxCell><mxCell id="legend" value="Rose: gui/ (new, the only package importing PySide6). Blue: application/. Green: cli/ presentation shared by both interfaces. Purple: level 3 adapters." style="text;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="56" width="1360" height="24" /></mxCell><mxCell id="run" value="gui «package»&#10;run(argv) -&gt; int; main()&#10;--database PATH, same file as the terminal&#10;open failure: dialog, status 2, file unchanged" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff1f2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="110" width="380" height="92" /></mxCell><mxCell id="window" value="MainWindow&#10;session: SalesSession&#10;prompter: Prompter&#10;company selector, new/edit company&#10;period: apply / all data; selection label&#10;attempt(action) -&gt; T | None  «error funnel»&#10;perform(action) -&gt; bool&#10;refresh(): redraws every page from the session" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff1f2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="230" width="380" height="168" /></mxCell><mxCell id="page" value="Page «abstract tab»&#10;refresh()" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff1f2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="430" width="380" height="62" /></mxCell><mxCell id="pages" value="Pages (side navigation)&#10;HomePage: company cards, demo data&#10;OverviewPage: indicator cards, top products&#10;CatalogPage / SalesPage: records, CSV import&#10;AnalysesPage / ForecastPage: translated tables&#10;ChartsPage: InteractiveChart (zoom, pan, hover)&#10;ReportPage: PDF preview and export" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff1f2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="520" width="380" height="168" /></mxCell><mxCell id="prompter" value="Prompter «protocol»&#10;inform(); warn(); confirm() -&gt; bool&#10;open_csv(); choose_folder()&#10;company_form(); product_form(); sale_form()&#10;(tests: ScriptedPrompter)" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff1f2;" vertex="1" parent="1"><mxGeometry as="geometry" x="460" y="230" width="300" height="132" /></mxCell><mxCell id="qtprompter" value="QtPrompter&#10;QMessageBox, QFileDialog, forms" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff1f2;" vertex="1" parent="1"><mxGeometry as="geometry" x="460" y="400" width="300" height="52" /></mxCell><mxCell id="forms" value="forms «module»&#10;CompanyDialog -&gt; CompanyValues&#10;ProductDialog -&gt; ProductValues&#10;SaleDialog -&gt; SaleValues (Decimal from text)" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff1f2;" vertex="1" parent="1"><mxGeometry as="geometry" x="460" y="480" width="300" height="112" /></mxCell><mxCell id="reports" value="reports «module» (Qt-free)&#10;financial_cards(); top_products_table()&#10;analysis_table(); period_comparison_table()&#10;linear_forecast_report(); comparison_report()&#10;Card, Table, Report (formatted only)" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff1f2;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="230" width="300" height="132" /></mxCell><mxCell id="messages" value="messages «module» (Qt-free)&#10;describe_failure(error) -&gt; str" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#fff1f2;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="400" width="300" height="62" /></mxCell><mxCell id="cli" value="cli.formatting / cli.parsing (shared)&#10;format_*(); explain_forecast_error()&#10;describe_import_error/refusal()&#10;parse_amount(); parse_datetime(); parse_horizon()" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#ecfdf5;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="490" width="300" height="112" /></mxCell><mxCell id="session" value="SalesSession&#10;selection; current workspace&#10;run_financial/product_analysis()&#10;sales_over_time(); compare_forecasts()&#10;+ top_products(limit) (level 4)&#10;+ chart_data() (level 4)" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#eff6ff;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="110" width="260" height="150" /></mxCell><mxCell id="chartdata" value="ChartData «value»&#10;title; daily; monthly&#10;top_products: ProductRevenue[]&#10;forecast; forecast_title; forecast_key&#10;forecast_refusal; weekday" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#eff6ff;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="290" width="260" height="112" /></mxCell><mxCell id="workspace" value="CompanyWorkspace&#10;catalog, sales, import_sales()&#10;(level 3, unchanged)" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;verticalAlign=top;fillColor=#eff6ff;" vertex="1" parent="1"><mxGeometry as="geometry" x="1140" y="430" width="260" height="72" /></mxCell><mxCell id="images" value="charts.images&#10;ChartInputs.from_data(data, weekday_names)&#10;build_figure(kind, inputs, labels) -&gt; Figure&#10;ChartLabels (English defaults for PNG)&#10;save_charts(inputs, folder, replace)" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacingLeft=8;vertical