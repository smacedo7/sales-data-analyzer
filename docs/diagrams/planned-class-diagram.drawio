          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="notes" value="FUTURE CONTRACTS&#10;• SalesService coordinates manual sales and imports. Saving a sale and its items is atomic.&#10;• Reject a sale_id already stored for the selected company; importing a file twice must not double revenue.&#10;• SQLAlchemySaleRepository uses SQLite and loads the complete sale aggregate. query returns a SalesDataset.&#10;• Reports reference a company and a period; AnalysisResult objects can be shared by different reports.&#10;• MainWindow also invokes Analysis and ChartGenerator from page 2. Business calculations stay outside the UI.&#10;• See the extension page for catalog management and explicit reporting/presentation connections." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#243247;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1010" width="1480" height="180" />
        </mxCell>
